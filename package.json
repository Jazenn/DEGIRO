{
  "name": "degiro-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "hosted:test": "vitest run --config hosted/vitest.config.ts",
    "hosted:typecheck": "tsc -p hosted/tsconfig.json",
    "hosted:build": "npm run hosted:typecheck && npx --yes wrangler@4.152.0 deploy --dry-run --config hosted/wrangler.toml --outdir hosted/.wrangler/build",
    "hosted:verify": "node --experimental-strip-types hosted/verify-neon.ts",
    "hosted:sql-test": "node --test hosted/sql-regression.mjs hosted/crypto-execution-sql.test.mjs hosted/crypto-replacement-sql.test.mjs && vitest run --config hosted/vitest-sql.config.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "decimal.js": "^10.6.0",
    "jose": "^6.1.3",
    "lucide-react": "^1.59.0",
    "oauth4webapi": "^3.8.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.13.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "jsdom": "^26.0.0",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
